# Monorepo root — applies to whole repo (subfolder .gitignore files still apply below)

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
*.iml
.vscode/
*.code-workspace

# Python (e.g. frontend/.venv for write_zh_hk.py)
.venv/
venv/
__pycache__/
*.pyc

# =============================================================================
# Secrets / local config — NEVER commit
# Templates (*.template, env.*.example) stay tracked.
# =============================================================================

# Dotenv (all packages)
.env
.env.*
**/.env
**/.env.*
!**/.env.*.example
!**/env.*.example

# Deploy local secrets (example without leading dot is OK to commit: env.prod.example)
deploy/.env.prod
deploy/.env.prod.example

# Spring Boot local overrides (real DB / Stripe / JWT / MinIO)
**/application.properties
**/application-dev.properties
**/application-local.properties
**/application-secret.properties
# Keep safe committed stubs + templates:
#   application-prod.properties, application-staging.properties
#   application*.properties.template

# Keys, certs, credential dumps
*.pem
*.p12
*.jks
*.keystore
id_rsa
id_rsa.pub
**/credentials.json
**/service-account*.json
**/google-services.json

# Node (frontend)
**/node_modules/
**/.angular/cache
**/dist/

# Java (backend)
**/target/

# Logs & local tooling
*.log
.npm/

# Private deploy notes (optional local-only docs)
deploy/Caddyfile
deploy/GIT_MONOREPO_FIX.md
deploy/HETZNER_SERVER_SETUP.md
DEPLOYMENT_PLAN.md
