# Copy this file to application-dev.properties and fill in the real values.
# application-dev.properties is git-ignored and must NEVER be committed.
# Prefer env vars for secrets when possible (see application-prod.properties).

server.port=8080
spring.datasource.url=jdbc:postgresql://localhost:5432/storedb
spring.datasource.username=YOUR_DB_USERNAME
spring.datasource.password=YOUR_DB_PASSWORD
spring.jpa.hibernate.ddl-auto=none
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration

# Storage / MinIO
storage.public-base-url=http://localhost:9000/YOUR_BUCKET_NAME/
storage.minio.endpoint=http://localhost:9000
storage.minio.access-key=YOUR_MINIO_ACCESS_KEY
storage.minio.secret-key=YOUR_MINIO_SECRET_KEY
storage.minio.bucket=YOUR_BUCKET_NAME

# Instagram Graph API
# Generate a token from: https://developers.facebook.com/apps/YOUR_APP_ID/instagram-api/
# The backend auto-refreshes this token every 50 days — no manual renewal needed.
instagram.access-token=${INSTAGRAM_ACCESS_TOKEN:YOUR_INSTAGRAM_ACCESS_TOKEN}

# Shipping zone rates live in application.yml (app.shipping.zones) — ShippingProperties only (guide 02 / 08).

# JWT — override via APP_JWT_SECRET in shared/dev machines
app.jwt.secret=${APP_JWT_SECRET:dev-only-change-me-use-a-long-secret-key!!}
app.jwt.expiration-ms=86400000

# Stripe (test mode) — see guide 03. Never commit sk_live_ or real secrets.
stripe.secret-key=${STRIPE_SECRET_KEY:sk_test_replace_me}
stripe.webhook-secret=${STRIPE_WEBHOOK_SECRET:whsec_replace_me}
app.checkout.success-url=http://localhost:4200/checkout/success
app.checkout.cancel-url=http://localhost:4200/cart

# Local mail via Mailhog (guide 06) — UI http://localhost:8025
spring.mail.host=localhost
spring.mail.port=1025
spring.mail.username=
spring.mail.password=
app.mail.from=orders@localhost
app.mail.from-orders=orders@localhost
app.mail.from-noreply=noreply@localhost
app.mail.shop-name=Lovely Dearly

# Local Angular origin for links in email (verify / view order).
# Prod uses APP_PUBLIC_WEB_BASE_URL=https://lovelydearly.ca — never localhost there.
app.public-web-base-url=http://localhost:4200

# Dev admin seed (guide 07) — creates ADMIN user if missing. Leave blank / omit in prod.
# app.admin.email=admin@localhost
# app.admin.password=admin-dev-only
