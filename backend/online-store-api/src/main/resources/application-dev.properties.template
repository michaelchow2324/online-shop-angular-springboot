# Copy this file to application-dev.properties and fill in the real values.
# application-dev.properties is git-ignored and must NEVER be committed.

server.port=8080
spring.datasource.url=jdbc:postgresql://localhost:5432/storedb
spring.datasource.username=YOUR_DB_USERNAME
spring.datasource.password=YOUR_DB_PASSWORD
spring.jpa.hibernate.ddl-auto=none
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration

# Storage / MinIO
storage.public-base-url=http://localhost:9000/YOUR_BUCKET_NAME/
storage.minio.endpoint=http://localhost:9000
storage.minio.access-key=YOUR_MINIO_ACCESS_KEY
storage.minio.secret-key=YOUR_MINIO_SECRET_KEY
storage.minio.bucket=YOUR_BUCKET_NAME

# Instagram Graph API
# Generate a token from: https://developers.facebook.com/apps/YOUR_APP_ID/instagram-api/
# The backend auto-refreshes this token every 50 days — no manual renewal needed.
instagram.access-token=YOUR_INSTAGRAM_ACCESS_TOKEN

# Shipping zone rates live in application.yml (app.shipping.zones) — see guide 02.

# Stripe (test mode) — see guide 03. Never commit real keys.
stripe.secret-key=${STRIPE_SECRET_KEY:sk_test_replace_me}
stripe.webhook-secret=${STRIPE_WEBHOOK_SECRET:whsec_replace_me}
app.checkout.success-url=http://localhost:4200/checkout/success
app.checkout.cancel-url=http://localhost:4200/cart

# Local mail via Mailhog (guide 06) — UI http://localhost:8025
spring.mail.host=localhost
spring.mail.port=1025
spring.mail.username=
spring.mail.password=
app.mail.from=orders@localhost
