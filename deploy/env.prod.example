# Production secrets checklist — copy to deploy/.env.prod (gitignored).
# Never commit real values. Never commit sk_live_ / whsec_ / DB passwords.
#
#   cp env.prod.example .env.prod && nano .env.prod
#   docker compose -f docker-compose.prod.yml up -d --build

DOMAIN=yourshop.com
ACME_EMAIL=you@yourshop.com

POSTGRES_DB=storedb
POSTGRES_USER=store
POSTGRES_PASSWORD=replace-with-strong-password

# Cloudflare R2 (or compatible) — not localhost MinIO
STORAGE_PUBLIC_BASE_URL=https://cdn.yourshop.com/
STORAGE_MINIO_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
STORAGE_MINIO_ACCESS_KEY=
STORAGE_MINIO_SECRET_KEY=
STORAGE_MINIO_BUCKET=online-store

# Spring profile prod reads these (see application-prod.properties)
APP_JWT_SECRET=replace-with-at-least-32-char-secret!!
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
APP_PUBLIC_WEB_BASE_URL=https://yourshop.com
APP_CHECKOUT_SUCCESS_URL=https://yourshop.com/checkout/success
APP_CHECKOUT_CANCEL_URL=https://yourshop.com/cart
APP_CORS_ALLOWED_ORIGINS=https://yourshop.com,https://www.yourshop.com
APP_MAIL_FROM=orders@yourshop.com
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

INSTAGRAM_ACCESS_TOKEN=
