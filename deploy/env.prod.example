# Production secrets checklist — copy to deploy/.env.prod (gitignored).
# Never commit real values. Never commit sk_live_ / whsec_ / DB passwords.
#
#   cp env.prod.example .env.prod && nano .env.prod
#   docker compose -f docker-compose.prod.yml up -d --build

DOMAIN=yourshop.com
ACME_EMAIL=you@yourshop.com

POSTGRES_DB=storedb
POSTGRES_USER=store
POSTGRES_PASSWORD=replace-with-strong-password

# Cloudflare R2 (or compatible) — not localhost MinIO
STORAGE_PUBLIC_BASE_URL=https://cdn.yourshop.com/
STORAGE_MINIO_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
STORAGE_MINIO_ACCESS_KEY=
STORAGE_MINIO_SECRET_KEY=
STORAGE_MINIO_BUCKET=online-store

# Spring profile prod reads these (see application-prod.properties)
APP_JWT_SECRET=replace-with-at-least-32-character-secret
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
APP_PUBLIC_WEB_BASE_URL=https://lovelydearly.ca
APP_CHECKOUT_SUCCESS_URL=https://lovelydearly.ca/checkout/success
APP_CHECKOUT_CANCEL_URL=https://lovelydearly.ca/cart
APP_CORS_ALLOWED_ORIGINS=https://lovelydearly.ca,https://www.lovelydearly.ca
# Mail From: orders = paid/shipped; noreply = verify/registration
APP_MAIL_FROM=orders@lovelydearly.ca
APP_MAIL_FROM_ORDERS=orders@lovelydearly.ca
APP_MAIL_FROM_NOREPLY=noreply@lovelydearly.ca
# Optional — defaults to "Lovely Dearly" in application-prod.properties
# APP_MAIL_SHOP_NAME=Lovely Dearly
SPRING_MAIL_HOST=smtp.mx.cloudflare.net
SPRING_MAIL_PORT=465
SPRING_MAIL_USERNAME=api_token
SPRING_MAIL_PASSWORD=

INSTAGRAM_ACCESS_TOKEN=

# Optional one-shot ADMIN seed — set once, recreate backend, log in, then remove these lines
# APP_ADMIN_EMAIL=you@your-real-email.com
# APP_ADMIN_PASSWORD=choose-a-strong-password
